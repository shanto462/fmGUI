{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window: only what the UI uses.",
  "windows": [
    "main",
    "quick"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
