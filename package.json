{
  "name": "fmgui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "app": "tauri dev",
    "app:build": "tauri build",
    "test:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test",
    "test:integration": "cd src-tauri && FM_INTEGRATION=1 cargo test",
    "lint": "eslint . && cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt --check",
    "verify": "scripts/verify.sh",
    "preview:mock": "vite --open /?mock=1",
    "version:set": "scripts/set-version.sh",
    "version:next": "node scripts/next-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "description": "A modern macOS 27 app for Apple's fm CLI (on-device Foundation Models): chat with tools, MCP servers and skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/shanto462/fmGUI.git"
  },
  "author": "Shanto"
}
